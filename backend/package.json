{
  "name": "@campussphere/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "check:config": "node scripts/check-config.mjs",
    "check:sql": "node scripts/check-sql.mjs",
    "smoke:cloud": "node scripts/smoke-cloud.mjs",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link --project-ref %SUPABASE_PROJECT_REF%",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
