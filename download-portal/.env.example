# CampusSphere download portal - environment
# Copy to .env.local for local dev, or set these in your host's build settings.
# Everything here is public: Vite inlines VITE_* values into the client bundle.
# Never put a Supabase service-role key or any secret in this file.

# --- APK source -------------------------------------------------------------
# owner/repo that publishes the release assets.
VITE_GITHUB_REPO=Code-Game-Ninja/campus
# Shown when the GitHub API is unreachable or rate limited (60 req/hr per IP).
VITE_RELEASES_URL=https://github.com/Code-Game-Ninja/campus/releases/latest

# --- Report form ------------------------------------------------------------
# Web3Forms access key. Free plan: 250 submissions/month, no file attachments.
# Leave blank to run the form in preview mode (validates, delivers nothing).
VITE_WEB3FORMS_KEY=

# --- Screenshot upload ------------------------------------------------------
# Free form-backend plans do not accept attachments, so the screenshot goes
# browser -> Cloudinary and only the URL is sent with the form.
#
# SECURITY: an unsigned preset is a public write surface. In the Cloudinary
# console, configure the preset with: unsigned mode, allowed formats limited to
# png/jpg/webp, max file size 5 MB, a dedicated folder, and moderation enabled.
# Rotate the preset name if it starts getting abused.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=
