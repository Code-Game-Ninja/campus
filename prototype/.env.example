# Public client values only. Never place service-role, database, Azure, Meilisearch, LLM, scanner, or FCM secrets here.
# Render backend URL. Device claims use it to record the trusted client IP.
# If omitted, device binding still works directly through Supabase without IP capture.
EXPO_PUBLIC_API_URL=https://campussphere-admin.onrender.com
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
