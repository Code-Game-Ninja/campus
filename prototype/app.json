{
  "expo": {
    "name": "Cloud-Campus",
    "slug": "campus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "campussphere",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-logo.png",
    "splash": {
      "image": "./assets/app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0d0b"
    },
    "android": {
      "package": "com.campus.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-logo.png",
        "backgroundColor": "#0a0d0b"
      }
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cloud-Campus to select photos for your posts."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "587f06e9-7320-4f22-8e0e-ec3b8095d40b"
      }
    },
    "owner": "chirag1528"
  }
}
